{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Smkzz/GreenGap/blob/main/schemas/greengap-witness-aggregate-v1.json",
  "title": "GreenGap pytest runtime witness aggregate v1",
  "description": "Conservative aggregation of source-bound pytest runtime witnesses.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "mode",
    "complete",
    "outcome",
    "tool",
    "runtime_execution_identity",
    "source_commit",
    "denominator",
    "witnesses",
    "errors",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "greengap_pytest_runtime_aggregate" },
    "mode": { "const": "witness" },
    "complete": { "type": "boolean" },
    "outcome": { "enum": ["COMPLETE", "BLOCKED", "INCOMPLETE"] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime_proof"],
      "properties": {
        "name": { "const": "greengap" },
        "version": { "type": "string", "minLength": 1 },
        "runtime_proof": { "type": "boolean" }
      }
    },
    "runtime_execution_identity": { "enum": ["CERTIFIED", "NOT_CERTIFIED"] },
    "source_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_count"],
      "properties": { "node_count": { "type": "integer", "minimum": 0 } }
    },
    "witnesses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "identities", "union_executed_node_count", "duplicate_node_observations"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "identities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]+(?:\\|[A-Za-z0-9_.:/-]+){4}$" }
        },
        "union_executed_node_count": { "type": "integer", "minimum": 0 },
        "duplicate_node_observations": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,256}$" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeid", "path", "state", "blocking", "reason", "evidence"],
        "properties": {
          "nodeid": { "type": "string", "minLength": 3 },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
          },
          "state": {
            "enum": ["NOT_SEEN", "SKIPPED", "EXECUTED_PASS", "EXECUTED_FAIL", "UNKNOWN"]
          },
          "blocking": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
