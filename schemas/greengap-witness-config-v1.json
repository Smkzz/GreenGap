{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Smkzz/GreenGap/blob/main/schemas/greengap-witness-config-v1.json",
  "title": "GreenGap explicit pytest witness configuration v1",
  "description": "A bounded declaration of the collection surface and complete execution surface set. The exact file bytes are hashed into the generated witness manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["witness"],
  "properties": {
    "version": { "const": 1 },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "required"],
      "properties": {
        "collection": { "$ref": "#/$defs/surface_id" },
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/surface_id" }
        }
      }
    }
  },
  "$defs": {
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.:/-]+$"
    }
  }
}
